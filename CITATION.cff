preferred-citation:
  type: conference-paper
  title: "OutRank: Speeding up AutoML-Based Model Search for Large Sparse Data Sets with Cardinality-Aware Feature Ranking"
  authors:
    - family-names: Skrlj
      given-names: Blaz
    - family-names: Mramor
